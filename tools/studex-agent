#!/usr/bin/env python3
"""Small, dependency-free StudEx coding-agent control CLI."""
import argparse, json, os, re, sys, urllib.request
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REGISTRY = ROOT / "agents" / "registry.yaml"
LOG = ROOT / "reports" / "local" / "agent-runs.jsonl"

def registry_agents():
    text = REGISTRY.read_text()
    blocks = re.findall(r"(?ms)^  - id: ([^\n]+)\n(.*?)(?=^  - id: |\Z)", text)
    out = []
    for agent_id, body in blocks:
        def field(name, default=""):
            m = re.search(rf"^    {re.escape(name)}: ?([^\n]+)", body, re.M)
            return (m.group(1).strip().strip('"') if m else default)
        out.append({"id": agent_id, "role": field("role"), "status": field("status"),
                    "work_dir": field("work_dir"), "memory_dir": field("memory_dir")})
    return out

def now(): return datetime.now(timezone.utc).isoformat()

def run_agent(args):
    known = {a["id"]: a for a in registry_agents()}
    if args.agent not in known:
        raise SystemExit(f"unknown agent: {args.agent}; use `fleet list`")
    base = os.environ.get("STUDEX_MODEL_BASE_URL", "http://127.0.0.1:11434/v1").rstrip("/")
    model = os.environ.get("STUDEX_MODEL", "qwen2.5-coder:7b")
    payload = {"model": model, "messages": [
        {"role": "system", "content": f"You are StudEx agent {args.agent}. Propose changes before execution."},
        {"role": "user", "content": args.task}], "temperature": 0.2}
    record = {"time": now(), "agent": args.agent, "model": model, "base_url": base,
              "task": args.task, "work_dir": known[args.agent]["work_dir"]}
    if args.dry_run:
        print(json.dumps({**record, "request": payload}, indent=2)); return
    req = urllib.request.Request(base + "/chat/completions", data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=args.timeout) as response:
            result = json.load(response)
        record["response"] = result
        print(result.get("choices", [{}])[0].get("message", {}).get("content", json.dumps(result)))
    except Exception as exc:
        record["error"] = str(exc)
        print(f"model gateway unavailable: {exc}", file=sys.stderr)
        raise SystemExit(2)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as fh: fh.write(json.dumps(record) + "\n")

def main():
    parser = argparse.ArgumentParser(prog="studex-agent")
    sub = parser.add_subparsers(dest="command", required=True)
    fleet = sub.add_parser("fleet", help="show registered agents")
    fleet.add_argument("action", choices=["list"], default="list", nargs="?")
    model = sub.add_parser("model", help="show model gateway selection")
    model.add_argument("action", choices=["show"], default="show", nargs="?")
    run = sub.add_parser("run", help="send a task to the selected model adapter")
    run.add_argument("--agent", required=True); run.add_argument("--task", required=True)
    run.add_argument("--dry-run", action="store_true"); run.add_argument("--timeout", type=int, default=120)
    args = parser.parse_args()
    if args.command == "fleet":
        for a in registry_agents(): print(f"{a['id']:18} {a['status']:18} {a['role']}")
    elif args.command == "model":
        print(json.dumps({"base_url": os.environ.get("STUDEX_MODEL_BASE_URL", "http://127.0.0.1:11434/v1"), "model": os.environ.get("STUDEX_MODEL", "qwen2.5-coder:7b")}, indent=2))
    else: run_agent(args)
if __name__ == "__main__": main()
